# Copy to .env. With no key, the desk still runs the SOP on templated replies.

# Provider label. Aliases: openai|gpt, anthropic|claude,
# openrouter, ollama, groq, together, deepseek, mistral, gemini|google, fireworks.
LLM_PROVIDER=openai

# Preferred key name. Provider-specific names below also work.
LLM_API_KEY=

# Claude / Anthropic (set LLM_PROVIDER=anthropic or claude):
# ANTHROPIC_API_KEY=
# CLAUDE_API_KEY=
# LLM_MODEL=claude-haiku-4-5-20251001

# OpenAI:
# OPENAI_API_KEY=
# LLM_MODEL=gpt-4o-mini

# Other OpenAI-compatible hosts (set LLM_PROVIDER to match, or keep openai and set BASE_URL):
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# TOGETHER_API_KEY=
# DEEPSEEK_API_KEY=
# MISTRAL_API_KEY=
# GOOGLE_API_KEY=   # or GEMINI_API_KEY for Gemini OpenAI-compatible endpoint
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_BASE_URL=http://host.docker.internal:11434/v1

# Optional overrides. Defaults come from the provider preset.
# LLM_MODEL=
# LLM_BASE_URL=

MAX_VERIFY_ATTEMPTS=3
MAX_OFF_TOPIC=3
MAX_FRUSTRATION_TURNS=3
TRACE_ENABLED=true
APP_PORT=8000
