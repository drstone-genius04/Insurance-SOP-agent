# Copy to .env if you want a file. Compose also reads these from the shell.
# The only value you need for natural phrasing is LLM_API_KEY.
# With no key, the desk still runs the SOP on templated replies.

LLM_PROVIDER=openai
LLM_API_KEY=

# Optional. Defaults: gpt-4o-mini (openai) or claude-haiku-4-5-20251001 (anthropic).
# LLM_MODEL=gpt-4o-mini

# Optional. OpenAI-compatible base that precedes /chat/completions.
# OpenRouter: https://openrouter.ai/api/v1
# Ollama:     http://host.docker.internal:11434/v1
# LLM_BASE_URL=https://api.openai.com/v1

MAX_VERIFY_ATTEMPTS=3
MAX_OFF_TOPIC=3
MAX_FRUSTRATION_TURNS=3
TRACE_ENABLED=true
APP_PORT=8000
